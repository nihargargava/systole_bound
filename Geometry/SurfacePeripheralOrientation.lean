module

public import Core.SystolicCore
public import Mathlib.Data.Fin.Rev
public import Mathlib.Data.List.OfFn
public import Mathlib.Logic.Equiv.Bool

@[expose] public section

/-! The generator-index reversal needed when the one-puncture marking has the
opposite orientation from the native positive relator. -/

open scoped commutatorElement

namespace SystolicGrowth

noncomputable section

/-- Reverse handle order and exchange the two generators within each handle. -/
def surfacePeripheralOrientationGeneratorEquiv (g : ℕ) :
    SurfaceGenerator g ≃ SurfaceGenerator g where
  toFun x := (Fin.rev x.1, !x.2)
  invFun x := (Fin.rev x.1, !x.2)
  left_inv x := by cases x; simp
  right_inv x := by cases x; simp

@[simp] theorem surfacePeripheralOrientationGeneratorEquiv_apply
    (g : ℕ) (x : SurfaceGenerator g) :
    surfacePeripheralOrientationGeneratorEquiv g x = (Fin.rev x.1, !x.2) := rfl

/-- The induced free-group equivalence, explicitly generated by the reversed
handle indices and the within-handle flip. -/
def surfacePeripheralOrientationFreeEquiv (g : ℕ) :
    FreeGroup (SurfaceGenerator g) ≃* FreeGroup (SurfaceGenerator g) :=
  FreeGroup.freeGroupCongr (surfacePeripheralOrientationGeneratorEquiv g)

private theorem list_reverse_ofFn_finRev {α : Type*} {n : ℕ} (f : Fin n → α) :
    (List.ofFn f).reverse = List.ofFn (fun i => f (Fin.rev i)) := by
  apply List.ext_getElem
  · simp
  · intro k hk hk'
    rw [List.getElem_eq_getElem_reverse]
    simp only [List.reverse_reverse, List.length_reverse, List.length_ofFn,
      List.getElem_ofFn]
    congr 1
    apply Fin.ext
    simp only [Fin.val_rev]
    omega

/-- Reversing the oriented handle generators sends the positive surface word
to its inverse: handle order reverses, and each swapped commutator inverts. -/
theorem surfacePeripheralOrientationFreeEquiv_relator (g : ℕ) :
    surfacePeripheralOrientationFreeEquiv g (surfaceRelator g) =
      (surfaceRelator g)⁻¹ := by
  classical
  let c : Fin g → FreeGroup (SurfaceGenerator g) := fun i =>
    ⁅FreeGroup.of (i, false), FreeGroup.of (i, true)⁆
  have hlist : List.ofFn (fun i : Fin g => (c (Fin.rev i))⁻¹) =
      ((List.ofFn c).map fun w => w⁻¹).reverse := by
    calc
      List.ofFn (fun i : Fin g => (c (Fin.rev i))⁻¹) =
          (List.ofFn (fun i : Fin g => c (Fin.rev i))).map fun w => w⁻¹ := by
            rw [List.map_ofFn]
            change List.ofFn (fun i : Fin g => (c (Fin.rev i))⁻¹) =
              List.ofFn (fun i : Fin g => (c (Fin.rev i))⁻¹)
            rfl
      _ = (List.ofFn c).reverse.map fun w => w⁻¹ := by
            rw [list_reverse_ofFn_finRev]
      _ = ((List.ofFn c).map fun w => w⁻¹).reverse := by
            rw [List.map_reverse]
  have hprod : (List.ofFn (fun i : Fin g => (c (Fin.rev i))⁻¹)).prod =
      (List.ofFn c).prod⁻¹ := by
    rw [hlist]
    exact (List.prod_inv_reverse (List.ofFn c)).symm
  have hmapList : List.ofFn (fun i : Fin g =>
      FreeGroup.map (surfacePeripheralOrientationGeneratorEquiv g) (c i)) =
      List.ofFn (fun i : Fin g => (c (Fin.rev i))⁻¹) := by
    apply congrArg List.ofFn
    funext i
    simp only [c, map_commutatorElement, FreeGroup.map.of,
      surfacePeripheralOrientationGeneratorEquiv_apply]
    rw [← commutatorElement_inv]
    rfl
  change FreeGroup.map (surfacePeripheralOrientationGeneratorEquiv g)
      ((List.ofFn c).prod) = ((List.ofFn c).prod)⁻¹
  rw [map_list_prod, List.map_ofFn, Function.comp_def, hmapList, hprod]

#print axioms surfacePeripheralOrientationFreeEquiv_relator

end

end SystolicGrowth
