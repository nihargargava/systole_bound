public import Geometry.SurfaceOrbitMetric

@[expose] public section

/-!
# The actual compact chain quotient

The pieces are the prescribed punctured component carriers. At every
consecutive pair of components, the outgoing sphere is matched to the
incoming sphere by the concrete reflected circle isometry. The generated
equivalence relation defines the glued carrier and its quotient topology.
Compactness and the actual seam identifications are proved here; a marked
surface, the glued length metric and curvature are further obligations.
-/

open Metric Set UpperHalfPlane
open scoped UpperHalfPlane

namespace SystolicGrowth

/-- The component before an actual edge of the finite path. -/
def gluingChainEdgeLeft {n : ℕ} (k : Fin (n - 1)) : Fin n :=
  ⟨k.1, by have := k.2; omega⟩

/-- The component after the same actual edge. -/
def gluingChainEdgeRight {n : ℕ} (k : Fin (n - 1)) : Fin n :=
  ⟨k.1 + 1, by have := k.2; omega⟩

namespace ExerciseGluingPreparation

variable {C : ℝ} {g n : ℕ} {genera : Fin n → ℕ}
  {X : ∀ i, ClosedHyperbolicSurface (genera i)}

/-- Each actual piece retains exactly the disks prescribed by its path index. -/
abbrev ChainComponent (P : ExerciseGluingPreparation C g n genera X) (i : Fin n) :=
  (X i).PuncturedComponent (P.centers i).1 (P.centers i).2 (gluingRadius C g) i

/-- The actual topological disjoint union before gluing. -/
abbrev ChainPieces (P : ExerciseGluingPreparation C g n genera X) :=
  Σ i : Fin n, P.ChainComponent i

/-- The supplied all-deck separation in the exact collar units. -/
theorem separated_outer_add_inner (P : ExerciseGluingPreparation C g n genera X)
    (i : Fin n) (γ : (X i).deckGroup) :
    gluingEmbeddedRadius C g + gluingRadius C g ≤
      dist (P.centers i).1 (γ • (P.centers i).2) := by
  have h := P.separated i γ
  dsimp only [gluingSeparationRadius, gluingEmbeddedRadius] at h ⊢
  linarith

/-- The actual incoming boundary map into its retained component. -/
noncomputable def leftCirclePoint (P : ExerciseGluingPreparation C g n genera X)
    (i : Fin n) : sphere (P.centers i).1 (gluingRadius C g) → P.ChainComponent i :=
  (X i).leftPunctureCircleMap (P.centers i).1 (P.centers i).2
    (gluingRadius C g) (gluingEmbeddedRadius C g) i
    P.radius_lt_embeddedRadius (P.twice_outer_lt_systole i)
    (P.separated_outer_add_inner i)

/-- The actual outgoing boundary map into its retained component. -/
noncomputable def rightCirclePoint (P : ExerciseGluingPreparation C g n genera X)
    (i : Fin n) : sphere (P.centers i).2 (gluingRadius C g) → P.ChainComponent i :=
  (X i).rightPunctureCircleMap (P.centers i).1 (P.centers i).2
    (gluingRadius C g) (gluingEmbeddedRadius C g) i
    P.radius_lt_embeddedRadius (P.twice_outer_lt_systole i)
    (P.separated_outer_add_inner i)

theorem leftCirclePoint_isEmbedding (P : ExerciseGluingPreparation C g n genera X)
    (i : Fin n) : Topology.IsEmbedding (P.leftCirclePoint i) :=
  (X i).leftPunctureCircleMap_isEmbedding (P.centers i).1 (P.centers i).2
    (gluingRadius C g) (gluingEmbeddedRadius C g) i
    P.radius_lt_embeddedRadius (P.twice_outer_lt_systole i)
    (P.separated_outer_add_inner i)

theorem rightCirclePoint_isEmbedding (P : ExerciseGluingPreparation C g n genera X)
    (i : Fin n) : Topology.IsEmbedding (P.rightCirclePoint i) :=
  (X i).rightPunctureCircleMap_isEmbedding (P.centers i).1 (P.centers i).2
    (gluingRadius C g) (gluingEmbeddedRadius C g) i
    P.radius_lt_embeddedRadius (P.twice_outer_lt_systole i)
    (P.separated_outer_add_inner i)

/-- The outgoing point in the disjoint union at a specified path edge. -/
noncomputable def seamSource (P : ExerciseGluingPreparation C g n genera X)
    (k : Fin (n - 1))
    (z : sphere (P.centers (gluingChainEdgeLeft k)).2 (gluingRadius C g)) : P.ChainPieces :=
  ⟨gluingChainEdgeLeft k, P.rightCirclePoint _ z⟩

/-- Its concrete reflected match in the next component. -/
noncomputable def seamTarget (P : ExerciseGluingPreparation C g n genera X)
    (k : Fin (n - 1))
    (z : sphere (P.centers (gluingChainEdgeLeft k)).2 (gluingRadius C g)) : P.ChainPieces :=
  ⟨gluingChainEdgeRight k, P.leftCirclePoint _
    (gluingBoundaryCircleIsometry (P.centers (gluingChainEdgeLeft k)).2
      (P.centers (gluingChainEdgeRight k)).1 (gluingRadius C g) z)⟩

/-- Only these actual consecutive-circle pairs generate the gluing. -/
def chainRelation (P : ExerciseGluingPreparation C g n genera X)
    (a b : P.ChainPieces) : Prop :=
  ∃ k : Fin (n - 1), ∃ z : sphere (P.centers (gluingChainEdgeLeft k)).2 (gluingRadius C g),
    a = P.seamSource k z ∧ b = P.seamTarget k z

/-- The equivalence relation generated by the concrete seam identifications. -/
def chainSetoid (P : ExerciseGluingPreparation C g n genera X) : Setoid P.ChainPieces :=
  Relation.EqvGen.setoid P.chainRelation

/-- The actual glued carrier, with its induced quotient topology. -/
abbrev GluedCarrier (P : ExerciseGluingPreparation C g n genera X) :=
  Quotient P.chainSetoid

/-- The canonical map from the actual pieces to the glued carrier. -/
def gluedMk (P : ExerciseGluingPreparation C g n genera X) : P.ChainPieces → P.GluedCarrier :=
  Quotient.mk P.chainSetoid

instance chainPiecesCompactSpace (P : ExerciseGluingPreparation C g n genera X) :
    CompactSpace P.ChainPieces := by
  dsimp only [ChainPieces, ChainComponent]
  infer_instance

/-- A finite chain of actual compact punctured pieces has compact quotient. -/
instance gluedCarrierCompactSpace (P : ExerciseGluingPreparation C g n genera X) :
    CompactSpace P.GluedCarrier := Quotient.compactSpace

theorem gluedMk_continuous (P : ExerciseGluingPreparation C g n genera X) :
    Continuous P.gluedMk := continuous_quotient_mk'

/-- The two explicitly matched boundary points are equal in the actual quotient. -/
theorem gluedMk_seamSource_eq_seamTarget (P : ExerciseGluingPreparation C g n genera X)
    (k : Fin (n - 1))
    (z : sphere (P.centers (gluingChainEdgeLeft k)).2 (gluingRadius C g)) :
    P.gluedMk (P.seamSource k z) = P.gluedMk (P.seamTarget k z) := by
  apply Quotient.sound
  exact Relation.EqvGen.rel _ _ ⟨k, z, rfl, rfl⟩

/-- The generating relation never glues two points of the same component. -/
theorem chainRelation_components_ne (P : ExerciseGluingPreparation C g n genera X)
    {a b : P.ChainPieces} (hab : P.chainRelation a b) : a.1 ≠ b.1 := by
  obtain ⟨k, z, rfl, rfl⟩ := hab
  intro h
  have hv := congrArg Fin.val h
  change k.1 = k.1 + 1 at hv
  omega

end ExerciseGluingPreparation

#print axioms ExerciseGluingPreparation.gluedCarrierCompactSpace
#print axioms ExerciseGluingPreparation.gluedMk_seamSource_eq_seamTarget
#print axioms ExerciseGluingPreparation.chainRelation_components_ne

end SystolicGrowth
