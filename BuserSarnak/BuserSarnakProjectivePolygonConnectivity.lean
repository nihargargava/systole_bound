module

public import BuserSarnak.BuserSarnakProjectivePolygonGeneration

@[expose] public section

/-!
# Connectivity of the projective polygon dual graph

The six side-pairing translations generate the finite projective quotient.
This file turns that algebraic fact into a constructive reachability theorem
for polygon faces: the side-pairing relation reaches every face from the base
face, without assuming dual-graph connectivity.
-/

namespace SystolicGrowth

noncomputable section

open ReidemeisterSchreier.Discrete
open ReidemeisterSchreier.Discrete.Presentations

/-- The six side-pairing translations reduced to a finite projective quotient. -/
def projectivePolygonPairingReductionElement
    (p : ℕ) [NeZero p] :
    ProjectivePolygonPairingGenerator → BuserSarnakProjectiveReductionRange p :=
  fun i => buserSarnakProjectiveReductionPresentedHom p
    (projectivePolygonPairingElement i)

/-- Every image of a standard octagon generator belongs to the subgroup
generated by the six reduced side-pairing translations. -/
theorem projectivePolygonPairingReductionElements_contain_generator_images
    {p : ℕ} [NeZero p] (x : ProjectiveOctagonGenerator) :
    buserSarnakProjectiveReductionImage p x ∈
      Subgroup.closure (Set.range (projectivePolygonPairingReductionElement p)) := by
  have h1 : buserSarnakProjectiveReductionImage p .e1 *
      buserSarnakProjectiveReductionImage p .e1 = 1 := by
    simpa [pow_two] using
      buserSarnakProjectiveReductionImage_cone_sq p .e1 (by simp)
  have h2 : buserSarnakProjectiveReductionImage p .e2 *
      buserSarnakProjectiveReductionImage p .e2 = 1 := by
    simpa [pow_two] using
      buserSarnakProjectiveReductionImage_cone_sq p .e2 (by simp)
  have h3 : buserSarnakProjectiveReductionImage p .e3 *
      buserSarnakProjectiveReductionImage p .e3 = 1 := by
    simpa [pow_two] using
      buserSarnakProjectiveReductionImage_cone_sq p .e3 (by simp)
  have h4 : buserSarnakProjectiveReductionImage p .e4 *
      buserSarnakProjectiveReductionImage p .e4 = 1 := by
    simpa [pow_two] using
      buserSarnakProjectiveReductionImage_cone_sq p .e4 (by simp)
  have hp : buserSarnakProjectiveReductionImage p .a *
      buserSarnakProjectiveReductionImage p .e1 *
      (buserSarnakProjectiveReductionImage p .c)⁻¹ *
      buserSarnakProjectiveReductionImage p .e2 *
      (buserSarnakProjectiveReductionImage p .a)⁻¹ *
      buserSarnakProjectiveReductionImage p .e3 *
      buserSarnakProjectiveReductionImage p .c *
      buserSarnakProjectiveReductionImage p .e4 = 1 := by
    have h := buserSarnakProjectiveReductionImage_relations p
      (projectiveOctagonRelator .polygon)
      (⟨.polygon, rfl⟩ : projectiveOctagonRelator .polygon ∈ projectiveOctagonRelators)
    simpa [projectiveOctagonRelator, map_mul, map_inv, FreeGroup.lift_apply_of] using h
  have h := projectivePolygonPairingGeneratorElements_contain_generators
    (buserSarnakProjectiveReductionImage p .a)
    (buserSarnakProjectiveReductionImage p .c)
    (buserSarnakProjectiveReductionImage p .e1)
    (buserSarnakProjectiveReductionImage p .e2)
    (buserSarnakProjectiveReductionImage p .e3)
    (buserSarnakProjectiveReductionImage p .e4)
    h1 h2 h3 h4 hp
  have hpair : projectivePolygonPairingReductionElement p =
      projectivePolygonPairingGeneratorElement
        (buserSarnakProjectiveReductionImage p .a)
        (buserSarnakProjectiveReductionImage p .c)
        (buserSarnakProjectiveReductionImage p .e1)
        (buserSarnakProjectiveReductionImage p .e2)
        (buserSarnakProjectiveReductionImage p .e3)
        (buserSarnakProjectiveReductionImage p .e4) := by
    funext i
    cases i <;>
      simp [projectivePolygonPairingReductionElement,
        projectivePolygonPairingElement,
        projectivePolygonPairingGeneratorElement,
        buserSarnakProjectiveReductionPresentedHom_of, map_mul, map_inv]
  rw [hpair]
  cases x
  · exact h.1
  · exact h.2.1
  · exact h.2.2.1
  · exact h.2.2.2.1
  · exact h.2.2.2.2.1
  · exact h.2.2.2.2.2

/-- The six reduced side-pairing translations generate the entire finite
projective quotient. -/
theorem projectivePolygonPairingReductionElements_generate
    (p : ℕ) [NeZero p] :
    Subgroup.closure (Set.range (projectivePolygonPairingReductionElement p)) = ⊤ := by
  let H := Subgroup.closure (Set.range (projectivePolygonPairingReductionElement p))
  let f := buserSarnakProjectiveReductionPresentedHom p
  have himage (x : ProjectiveOctagonGenerator) :
      f (PresentedGroup.of x) ∈ H := by
    dsimp [f]
    rw [buserSarnakProjectiveReductionPresentedHom_of]
    exact projectivePolygonPairingReductionElements_contain_generator_images x
  let K : Subgroup ProjectiveOctagonGroup := H.comap f
  have hK : K = ⊤ := by
    apply top_unique
    rw [← PresentedGroup.closure_range_of projectiveOctagonRelators]
    apply (Subgroup.closure_le _).2
    rintro _ ⟨x, rfl⟩
    exact himage x
  have hf : MonoidHom.range f = ⊤ :=
    MonoidHom.range_eq_top.mpr (buserSarnakProjectiveReductionPresentedHom_surjective p)
  apply top_unique
  rw [← hf]
  rintro _ ⟨x, rfl⟩
  change x ∈ K
  rw [hK]
  trivial

namespace BuserSarnakProjectiveQuotientSectionData

/-- Crossing the distinguished side for a basic pairing translation moves the
base face by its reduced group element. -/
theorem polygonSidePartner_basic_eq_mul
    {p : ℕ} [NeZero p]
    (S : BuserSarnakProjectiveQuotientSectionData p)
    (q : BuserSarnakProjectiveReductionRange p)
    (i : ProjectivePolygonPairingGenerator) :
    (S.polygonSidePartner q i.side).1 =
      q * projectivePolygonPairingReductionElement p i := by
  have cone_inv (e : ProjectiveOctagonGenerator)
      (he : e = .e1 ∨ e = .e2 ∨ e = .e3 ∨ e = .e4) :
      (buserSarnakProjectiveReductionImage p e)⁻¹ =
        buserSarnakProjectiveReductionImage p e := by
    have hs : buserSarnakProjectiveReductionImage p e *
        buserSarnakProjectiveReductionImage p e = 1 := by
      simpa [pow_two] using
        buserSarnakProjectiveReductionImage_cone_sq p e he
    calc
      (buserSarnakProjectiveReductionImage p e)⁻¹ =
          (buserSarnakProjectiveReductionImage p e)⁻¹ * 1 := by simp
      _ = (buserSarnakProjectiveReductionImage p e)⁻¹ *
          (buserSarnakProjectiveReductionImage p e *
            buserSarnakProjectiveReductionImage p e) := by rw [hs]
      _ = buserSarnakProjectiveReductionImage p e := by group
  have hi1 := cone_inv .e1 (by simp)
  have hi2 := cone_inv .e2 (by simp)
  have hi3 := cone_inv .e3 (by simp)
  cases i <;>
    simp only [ProjectivePolygonPairingGenerator.side, polygonSidePartner,
      ProjectivePolygonSide.reverse, polygonSideEnd, polygonSideMove,
      polygonSideStart, polygonSideBase, polygonAfterA, polygonAfterE1,
      polygonAfterCInv, polygonAfterE2, polygonAfterAInv, polygonAfterE3,
      polygonAfterC, FiniteQuotientSchreierData.transition_eq,
      FiniteQuotientSchreierData.inverseTransition_eq,
      S.schreierData_quotientMap, buserSarnakProjectiveReductionMap,
      FreeGroup.lift_apply_of, projectivePolygonPairingReductionElement,
      projectivePolygonPairingElement,
      projectivePolygonPairingGeneratorElement,
      buserSarnakProjectiveReductionPresentedHom_of, map_mul, map_inv]
  · rw [hi1, hi2]
    group
  · group
  · rw [hi1, hi2, hi3]
    group
  · rw [hi1]
    group
  · rw [hi1, hi2]
    group
  · rw [hi1, hi2, hi3]
    group

end BuserSarnakProjectiveQuotientSectionData

/-- A directed Cayley step by a reduced side-pairing translation or its
inverse. -/
def projectivePolygonTranslationStep
    (p : ℕ) [NeZero p]
    (q r : BuserSarnakProjectiveReductionRange p) : Prop :=
  ∃ i : ProjectivePolygonPairingGenerator,
    r = q * projectivePolygonPairingReductionElement p i ∨
      r = q * (projectivePolygonPairingReductionElement p i)⁻¹

/-- One face-to-face move through a paired polygon side. -/
def projectivePolygonFaceStep
    {p : ℕ} [NeZero p]
    (S : BuserSarnakProjectiveQuotientSectionData p)
    (q r : BuserSarnakProjectiveReductionRange p) : Prop :=
  ∃ s : ProjectivePolygonSide, (S.polygonSidePartner q s).1 = r

/-- Translation steps can be reversed because both a generator and its inverse
are allowed. -/
theorem projectivePolygonTranslationStep_symm
    {p : ℕ} [NeZero p]
    {q r : BuserSarnakProjectiveReductionRange p}
    (h : projectivePolygonTranslationStep p q r) :
    projectivePolygonTranslationStep p r q := by
  rcases h with ⟨i, h | h⟩
  · refine ⟨i, Or.inr ?_⟩
    rw [h]
    group
  · refine ⟨i, Or.inl ?_⟩
    rw [h]
    group

/-- Left multiplication transports a path in the side-pairing Cayley graph. -/
theorem projectivePolygonTranslationStep_left_mul
    {p : ℕ} [NeZero p]
    (g q r : BuserSarnakProjectiveReductionRange p)
    (h : projectivePolygonTranslationStep p q r) :
    projectivePolygonTranslationStep p (g * q) (g * r) := by
  rcases h with ⟨i, h | h⟩
  · refine ⟨i, Or.inl ?_⟩
    rw [h]
    group
  · refine ⟨i, Or.inr ?_⟩
    rw [h]
    group

/-- Left multiplication transports any path in the side-pairing Cayley graph. -/
theorem projectivePolygonTranslationPath_left_mul
    {p : ℕ} [NeZero p]
    (g q r : BuserSarnakProjectiveReductionRange p)
    (h : Relation.ReflTransGen (projectivePolygonTranslationStep p) q r) :
    Relation.ReflTransGen (projectivePolygonTranslationStep p) (g * q) (g * r) := by
  exact h.lift (g * ·)
    (fun _ _ hstep => projectivePolygonTranslationStep_left_mul g _ _ hstep)

/-- Reverse a path in the symmetric side-pairing Cayley graph. -/
theorem projectivePolygonTranslationPath_reverse
    {p : ℕ} [NeZero p]
    {q r : BuserSarnakProjectiveReductionRange p}
    (h : Relation.ReflTransGen (projectivePolygonTranslationStep p) q r) :
    Relation.ReflTransGen (projectivePolygonTranslationStep p) r q := by
  induction h with
  | refl => rfl
  | tail hpath hstep ih =>
      exact (Relation.ReflTransGen.single
        (projectivePolygonTranslationStep_symm hstep)).trans ih

/-- The states reachable from the identity by side-pairing translations form
a subgroup of the finite projective quotient. -/
def projectivePolygonTranslationReachableSubgroup
    (p : ℕ) [NeZero p] : Subgroup (BuserSarnakProjectiveReductionRange p) where
  carrier := {q | Relation.ReflTransGen (projectivePolygonTranslationStep p) 1 q}
  one_mem' := Relation.ReflTransGen.refl
  mul_mem' := by
    intro q r hq hr
    exact hq.trans (by
      simpa using projectivePolygonTranslationPath_left_mul q 1 r hr)
  inv_mem' := by
    intro q hq
    have hback := projectivePolygonTranslationPath_reverse hq
    simpa using projectivePolygonTranslationPath_left_mul q⁻¹ q 1 hback

/-- Every finite projective quotient state is reachable from the identity by
side-pairing translations. -/
theorem projectivePolygonTranslationStep_reaches_all
    (p : ℕ) [NeZero p]
    (q : BuserSarnakProjectiveReductionRange p) :
    Relation.ReflTransGen (projectivePolygonTranslationStep p) 1 q := by
  let H := projectivePolygonTranslationReachableSubgroup p
  have hgens : Subgroup.closure
      (Set.range (projectivePolygonPairingReductionElement p)) ≤ H := by
    apply (Subgroup.closure_le _).2
    rintro _ ⟨i, rfl⟩
    exact Relation.ReflTransGen.single ⟨i, Or.inl (by simp)⟩
  rw [projectivePolygonPairingReductionElements_generate p] at hgens
  exact hgens (by trivial)

/-- Every translation step is realized by crossing a paired polygon side. -/
theorem projectivePolygonTranslationStep_le_faceStep
    {p : ℕ} [NeZero p]
    (S : BuserSarnakProjectiveQuotientSectionData p) :
    projectivePolygonTranslationStep p ≤ projectivePolygonFaceStep S := by
  intro q r h
  rcases h with ⟨i, h | h⟩
  · refine ⟨i.side, ?_⟩
    rw [BuserSarnakProjectiveQuotientSectionData.polygonSidePartner_basic_eq_mul, h]
  · let s := i.side
    have hforward : (S.polygonSidePartner r s).1 = q := by
      rw [BuserSarnakProjectiveQuotientSectionData.polygonSidePartner_basic_eq_mul, h]
      group
    have hpartner : S.polygonSidePartner r s = (q, s.reverse) := by
      apply Prod.ext
      · exact hforward
      · rfl
    have hinvolutive := S.polygonSidePartner_involutive r s
    rw [hpartner] at hinvolutive
    exact ⟨s.reverse, congrArg Prod.fst hinvolutive⟩

/-- The finite projective polygon face relation reaches every face from the
identity face. -/
theorem projectivePolygonFaceStep_reaches_all
    {p : ℕ} [NeZero p]
    (S : BuserSarnakProjectiveQuotientSectionData p)
    (q : BuserSarnakProjectiveReductionRange p) :
    Relation.ReflTransGen (projectivePolygonFaceStep S) 1 q := by
  exact Relation.ReflTransGen.mono
    (projectivePolygonTranslationStep_le_faceStep S)
    1 q (projectivePolygonTranslationStep_reaches_all p q)

end

end SystolicGrowth
